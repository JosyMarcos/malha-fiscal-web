{
  "version": 2,
  "builds": [
    {
      "src": "malha_fiscal/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "malha_fiscal/wsgi.py" }
  ]
}
